{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MiPDF",
  "version": "1.0.0",
  "identifier": "app.mipdf.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MiPDF",
        "width": 1280,
        "height": 840,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "msi"],
    "category": "Productivity",
    "shortDescription": "Editează, semnează și convertește PDF-uri",
    "longDescription": "MiPDF editează, semnează și convertește PDF-uri în Word și invers. Totul se procesează local, pe calculatorul tău.",
    "copyright": "© 2026 MiPDF",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      { "ext": ["pdf"], "name": "PDF", "description": "Document PDF", "role": "Editor", "mimeType": "application/pdf" }
    ],
    "macOS": { "minimumSystemVersion": "11.0" },
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["Romanian", "English"], "displayLanguageSelector": false },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
